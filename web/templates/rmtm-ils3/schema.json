      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "TaxonomicRankEnum",
      "required": false
    },
    "taxa_read_counts": {
      "name": "taxa_read_counts",
      "description": "A data item determining how many sequence reads have been assigned for a given taxon.",
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
