  "slots": {
    "sample_uuid": {
      "name": "sample_uuid",
      "description": "The 8-character unique identifier (UUID) for the sample",
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "string",
      "required": true,
      "pattern": "^[0-9a-fA-F]{8}$"
    },
    "sample_contaminated": {
      "name": "sample_contaminated",
      "description": "Whether the sample is considered contaminated based on bioinformatic workflow output",
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "SampleContaminationStatusEnum",
      "required": true
    },
    "taxa_scientific_name": {
      "name": "taxa_scientific_name",
