  "slots": {
    "sample_uuid": {
      "name": "sample_uuid",
      "description": "Unique 8-character hexadecimal identifier for the sample.",
      "examples": [
        {
          "value": "3f8a002b",
          "description": "Standard 8-character hexadecimal sample ID."
        }
      ],
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "domain_of": [
        "RMTM_ILS3_result"
      ],
      "range": "string",
      "required": true,
      "pattern": "^[0-9a-fA-F]{8}$"
    },
    "taxa_scientific_name": {
      "name": "taxa_scientific_name",
      "description": "The formal scientific name of the detected organism at whatever rank was identified  (e.g., 'Cutibacterium acnes' for species, 'Staphylococcus' for genus, 'Bacillaceae' for family).  Input 'not_applicable' if 0 taxa were detected.",
      "examples": [
        {
          "value": "Cutibacterium acnes",
          "description": "Species-level scientific name."
        },
        {
          "value": "Staphylococcus",
          "description": "Genus-level scientific name when species cannot be resolved."
        },
        {
          "value": "Bacillaceae",
          "description": "Family-level scientific name from broader high-throughput reads."
        },
        {
          "value": "not_applicable",
          "description": "Selected when 0 taxa are detected in the sample."
        }
      ],
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "slot_uri": "dwc:scientificName",
      "domain_of": [
        "RMTM_ILS3_result"
      ],
      "range": "string",
      "required": true
    },
    "taxa_rank": {
      "name": "taxa_rank",
      "description": "The taxonomic rank of the detected organism (e.g., species, genus).",
      "examples": [
        {
          "value": "species",
          "description": "Rank for a specific organism identification."
        },
        {
          "value": "not_applicable",
          "description": "Selected when no organism is detected in the sample."
        }
      ],
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "slot_uri": "TAXRANK:0000000",
      "domain_of": [
        "RMTM_ILS3_result"
      ],
      "range": "TaxonomicRankEnum",
      "required": true
    },
    "signal": {
      "name": "signal",
      "description": "The numeric magnitude of the detected readout corresponding to the signal unit (e.g., reads,  RPKM, core gene fraction, or 1 for presence and 0 for absence).",
      "examples": [
        {
          "value": "4520.0",
          "description": "Total sequencing read count mapped to the detected organism."
        },
        {
          "value": "0.0",
          "description": "Zero readout indicating a negative or sterile sample."
        }
      ],
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "slot_uri": "IAO:0000004",
      "domain_of": [
        "RMTM_ILS3_result"
      ],
      "range": "float",
      "required": true,
      "minimum_value": 0
    },
    "signal_unit": {
      "name": "signal_unit",
      "description": "The unit of measurement associated with the signal  (e.g., reads, RPKM, core gene fraction, or 1 for presence-absence).",
      "examples": [
        {
          "value": "reads",
          "description": "Raw read count metric from sequencing."
        },
        {
          "value": "presence_absence",
          "description": "Binary indicator metric for presence (1) or absence (0)."
        }
      ],
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "slot_uri": "IAO:0000039",
      "domain_of": [
        "RMTM_ILS3_result"
      ],
      "range": "SignalUnitEnum",
      "required": true
    },
    "notes": {
      "name": "notes",
      "description": "Additional notes about the sample classification event if applicable",
      "from_schema": "https://github.com/tslaird/DataHarmonizer/blob/dev-ils3/web/templates/rmtm-ils3/sample-return.yml",
      "domain_of": [
        "RMTM_ILS3_result"
      ],
      "range": "string"
    }
  },
