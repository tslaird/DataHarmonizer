{
  "name": "RMTM_ILS3_sample_results_validation",
  "description": "A schema for reporting sample contamination and taxonomic classification",
  "id": "https://example.com/Analysis",
  "version": "1.0.0",
  "prefixes": {
    "linkml": {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    },
    "xsd": {
      "prefix_prefix": "xsd",
      "prefix_reference": "http://www.w3.org/2001/XMLSchema#"
    },
    "shex": {
      "prefix_prefix": "shex",
      "prefix_reference": "http://www.w3.org/ns/shex#"
    },
    "schema": {
      "prefix_prefix": "schema",
      "prefix_reference": "http://schema.org/"
    }
  },
  "default_prefix": "https://example.com/Analysis/",
  "default_range": "string",
  "types": {
    "WhitespaceMinimizedString": {
      "name": "WhitespaceMinimizedString",
      "description": "A string that has all whitespace trimmed off of beginning and end, and all internal whitespace segments reduced to single spaces.",
      "from_schema": "https://example.com/Analysis",
      "typeof": "string",
      "base": "str",
      "uri": "xsd:token"
    },
    "string": {
      "name": "string",
      "description": "A character string",
      "from_schema": "https://example.com/Analysis",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "xsd:string"
    },
    "integer": {
      "name": "integer",
      "description": "An integer",
      "from_schema": "https://example.com/Analysis",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "xsd:integer"
    },
    "boolean": {
      "name": "boolean",
      "description": "A binary (true or false) value",
      "from_schema": "https://example.com/Analysis",
      "exact_mappings": [
        "schema:Boolean"
      ],
      "base": "Bool",
      "uri": "xsd:boolean",
      "repr": "bool"
    }
  },
  "enums": {
    "TaxonomicRankEnum": {
      "name": "TaxonomicRankEnum",
      "from_schema": "https://example.com/Analysis",
      "permissible_values": {
        "Kingdom": {
          "text": "Kingdom"
        },
        "Phylum": {
          "text": "Phylum"
        },
        "Class": {
          "text": "Class"
        },
        "Order": {
          "text": "Order"
        },
        "Family": {
          "text": "Family"
        },
        "Genus": {
          "text": "Genus"
        },
        "Species": {
          "text": "Species"
        },
        "Strain": {
          "text": "Strain"
        }
      }
    }
  },
  "slots": {
    "sample_uuid": {
      "name": "sample_uuid",
      "description": "The 36-character unique identifier (UUID) for the sample",
      "from_schema": "https://example.com/Analysis",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "string",
      "required": true,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "DatasetAnalysisReporting": {
      "name": "DatasetAnalysisReporting",
      "description": "Dataset analysis reporting (standardized format CSV / JSON file)",
      "from_schema": "https://example.com/Analysis",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "string",
      "required": true,
      "pattern": "^.*\\.(csv|json)$"
    },
    "SampleContaminated": {
      "name": "SampleContaminated",
      "description": "was the sample contaminated (Binary yes/no)",
      "from_schema": "https://example.com/Analysis",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "boolean",
      "required": true
    },
    "DetectedTaxaDetails": {
      "name": "DetectedTaxaDetails",
      "description": "Multiple detected taxa with resolution and read counts.",
      "from_schema": "https://example.com/Analysis",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "string",
      "multivalued": true,
      "pattern": "^[^|]+\\|(Kingdom|Phylum|Class|Order|Family|Genus|Species|Strain)\\|[0-9]+$"
    },
    "MinimumResolvedGenera": {
      "name": "MinimumResolvedGenera",
      "description": "Minimum resolved genera detected",
      "from_schema": "https://example.com/Analysis",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "integer"
    },
    "GeneraDetected": {
      "name": "GeneraDetected",
      "description": "what genera were detected?",
      "from_schema": "https://example.com/Analysis",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "string",
      "multivalued": true
    },
    "SpeciesDetected": {
      "name": "SpeciesDetected",
      "description": "what species were detected?",
      "from_schema": "https://example.com/Analysis",
      "domain_of": [
        "RMTM_ILS3_sample_results_validation"
      ],
      "range": "string",
      "multivalued": true
    }
  },
  "classes": {
    "dh_interface": {
      "name": "dh_interface",
      "description": "A DataHarmonizer interface",
      "from_schema": "https://example.com/Analysis"
    },
    "RMTM_ILS3_sample_results_validation": {
      "name": "RMTM_ILS3_sample_results_validation",
      "description": "A class representing dataset validation for RMTM interlab study",
      "from_schema": "https://example.com/Analysis",
      "is_a": "dh_interface",
      "slot_usage": {
        "sample_uuid": {
          "name": "sample_uuid",
          "rank": 1
        },
        "DatasetAnalysisReporting": {
          "name": "DatasetAnalysisReporting",
          "rank": 2,
          "slot_group": "Files"
        },
        "SampleContaminated": {
          "name": "SampleContaminated",
          "rank": 3,
          "slot_group": "Status"
        },
        "DetectedTaxaDetails": {
          "name": "DetectedTaxaDetails",
          "rank": 4,
          "slot_group": "Taxonomy"
        },
        "MinimumResolvedGenera": {
          "name": "MinimumResolvedGenera",
          "rank": 5,
          "slot_group": "Metrics"
        },
        "GeneraDetected": {
          "name": "GeneraDetected",
          "rank": 6,
          "slot_group": "Taxonomy"
        },
        "SpeciesDetected": {
          "name": "SpeciesDetected",
          "rank": 7,
          "slot_group": "Taxonomy"
        }
      },
      "attributes": {
        "sample_uuid": {
          "name": "sample_uuid",
          "description": "The 8-character unique identifier (UUID) for the sample",
          "from_schema": "https://example.com/Analysis",
          "rank": 1,
          "alias": "sample_uuid",
          "owner": "RMTM_ILS3_sample_results_validation",
          "domain_of": [
            "RMTM_ILS3_sample_results_validation"
          ],
          "range": "string",
          "required": true,
          "pattern": "^[0-9a-fA-F]{8}$"
        },
        "DatasetAnalysisReporting": {
          "name": "DatasetAnalysisReporting",
          "description": "Dataset analysis reporting (standardized format CSV / JSON file)",
          "from_schema": "https://example.com/Analysis",
          "rank": 2,
          "alias": "DatasetAnalysisReporting",
          "owner": "RMTM_ILS3_sample_results_validation",
          "domain_of": [
            "RMTM_ILS3_sample_results_validation"
          ],
          "slot_group": "Files",
          "range": "string",
          "required": true,
          "pattern": "^.*\\.(csv|json)$"
        },
        "SampleContaminated": {
          "name": "SampleContaminated",
          "description": "was the sample contaminated (Binary yes/no)",
          "from_schema": "https://example.com/Analysis",
          "rank": 3,
          "alias": "SampleContaminated",
          "owner": "RMTM_ILS3_sample_results_validation",
          "domain_of": [
            "RMTM_ILS3_sample_results_validation"
          ],
          "slot_group": "Status",
          "range": "boolean",
          "required": true
        },
        "DetectedTaxaDetails": {
          "name": "DetectedTaxaDetails",
          "description": "Multiple detected taxa with resolution and read counts.",
          "from_schema": "https://example.com/Analysis",
          "rank": 4,
          "alias": "DetectedTaxaDetails",
          "owner": "RMTM_ILS3_sample_results_validation",
          "domain_of": [
            "RMTM_ILS3_sample_results_validation"
          ],
          "slot_group": "Taxonomy",
          "range": "string",
          "multivalued": true,
          "pattern": "^[^|]+\\|(Kingdom|Phylum|Class|Order|Family|Genus|Species|Strain)\\|[0-9]+$"
        },
        "MinimumResolvedGenera": {
          "name": "MinimumResolvedGenera",
          "description": "Minimum resolved genera detected",
          "from_schema": "https://example.com/Analysis",
          "rank": 5,
          "alias": "MinimumResolvedGenera",
          "owner": "RMTM_ILS3_sample_results_validation",
          "domain_of": [
            "RMTM_ILS3_sample_results_validation"
          ],
          "slot_group": "Metrics",
          "range": "integer"
        },
        "GeneraDetected": {
          "name": "GeneraDetected",
          "description": "what genera were detected?",
          "from_schema": "https://example.com/Analysis",
          "rank": 6,
          "alias": "GeneraDetected",
          "owner": "RMTM_ILS3_sample_results_validation",
          "domain_of": [
            "RMTM_ILS3_sample_results_validation"
          ],
          "slot_group": "Taxonomy",
          "range": "string",
          "multivalued": true
        },
        "SpeciesDetected": {
          "name": "SpeciesDetected",
          "description": "what species were detected?",
          "from_schema": "https://example.com/Analysis",
          "rank": 7,
          "alias": "SpeciesDetected",
          "owner": "RMTM_ILS3_sample_results_validation",
          "domain_of": [
            "RMTM_ILS3_sample_results_validation"
          ],
          "slot_group": "Taxonomy",
          "range": "string",
          "multivalued": true
        }
      }
    }
  },
  "settings": {
    "Title_Case": {
      "setting_key": "Title_Case",
      "setting_value": "(((?<=\\b)[^a-z\\W]\\w*?|[\\W])+)"
    },
    "UPPER_CASE": {
      "setting_key": "UPPER_CASE",
      "setting_value": "[A-Z\\W\\d_]*"
    },
    "lower_case": {
      "setting_key": "lower_case",
      "setting_value": "[a-z\\W\\d_]*"
    }
  },
  "@type": "SchemaDefinition"
}